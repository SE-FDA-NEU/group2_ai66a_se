# --- PROJECT ---
PROJECT_NAME="Automated E-commerce Price Tracker"
COMPOSE_PROJECT_NAME=trakora-app

# --- ADMIN ACCOUNT ---
ADMIN_USERNAME=Admin
ADMIN_EMAIL=EMAIL_ADMIN_USER
ADMIN_PASSWORD=MAT_KHAU_ADMIN
# Gmail App Password for SMTP (16 characters; do not use your regular Gmail password).
# Leave blank to fall back to ADMIN_PASSWORD for existing local setups.
SMTP_PASSWORD=

# --- CONFIG---
HOST_PORT_FRONTEND=3000
HOST_PORT_BACKEND=8000
HOST_PORT_DB=5432
HOST_PORT_REDIS=6379

# --- DATABASE (POSTGRESQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECRET_PASSWORD
POSTGRES_DB=YOUR_DATABASE_NAME
# For hosted PostgreSQL (e.g. Supabase Session Pooler), set DATABASE_URL instead.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?ssl=require
DATABASE_URL=

# --- REDIS ---
REDIS_PASSWORD=YOUR_SECRET_PASSWORD
# Use Render Key Value's Internal URL in production (redis:// or rediss://).
# REDIS_URL=redis://<internal-host>:6379
REDIS_URL=

# --- BACKEND ---
API_V1_STR=/api/v1
# Comma-separated origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- FRONTEND ---
VITE_API_URL=/api/v1

# --- JWT ---
SECRET_KEY=YOUR_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# --- GOOGLE AUTH ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# --- RAPIDAPI PRODUCT LOOKUP (Real-Time Amazon Data) ---
RAPIDAPI_KEY=RAPIDAPI_KEY
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com
RAPIDAPI_PRODUCT_ENDPOINT=https://real-time-amazon-data.p.rapidapi.com/product-details
